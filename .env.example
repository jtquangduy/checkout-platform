# Copy to .env (gitignored) to override. Defaults in docker-compose.yml work
# fine without this file for local dev.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=devpassword

# RabbitMQ defaults to guest/guest (loopback-only) if left unset. Uncomment to
# use a non-default user, needed once a containerized service (not running on
# your host) has to connect, since "guest" only accepts localhost connections.
# RABBITMQ_USER=admin
# RABBITMQ_PASSWORD=devpassword
