{
  "name": "@platform/identity-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/scripts/generate-openapi.js",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "seed": "node dist/scripts/seed.js"
  },
  "dependencies": {
    "@platform/contracts": "workspace:*",
    "@platform/kernel": "workspace:*",
    "express": "^5.0.0",
    "mongodb": "^6.9.0",
    "zod": "^3.23.8",
    "argon2": "^0.41.1",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
